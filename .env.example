# Sarv Studio — API keys for scripts only (connectors keep their own keys).
# Copy to .env and fill in. Use spend-capped, scoped keys. Never commit .env.
FAL_KEY=
ELEVENLABS_API_KEY=
RUNWAYML_API_SECRET=
# Where generated files land
PROJECT_ROOT="/full/path/to/your/Persian Stories folder"   # set on each Mac; differs per person
# Whose log files this Mac writes: one lowercase word, reza or edris. Reza's files keep their old names (05_ops/cost-log.csv);
# everyone else gets _<name> added (05_ops/cost-log_edris.csv). Totals per film add all of them.
SARV_USER=reza
# Monthly hard caps (USD) — scripts refuse to run past these
FAL_MONTHLY_CAP=40
ELEVENLABS_MONTHLY_CAP=22
RUNWAY_MONTHLY_CAP=0
